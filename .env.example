# Copy this to `.env` (gitignored) and fill it in. Consumed by scripts/build_dmg.sh.
# Values come from your Apple Developer account (team ID, Developer ID identity, notarytool profile).

APP_NAME=Yank

# Apple Developer Team ID used by xcodebuild export and DMG signing.
TEAM_ID=YOUR_TEAM_ID

# Your Developer ID Application signing identity.
#   find it with:  security find-identity -v -p codesigning
SIGN_IDENTITY="Developer ID Application: Your Name (SCSCVE6L3U)"

# notarytool keychain profile name.
#   create it with:  xcrun notarytool store-credentials "YankNotary" --key AuthKey_XXXX.p8 --key-id <ID> --issuer <UUID>
NOTARY_PROFILE=YankNotary
