<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Extensions only need the App Group to read/write the shared store. -->
	<!-- CloudKit sync runs in the host app, not here. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.thepatientzero.yank</string>
	</array>
</dict>
</plist>
